# ============================================================
# JobHunter .gitignore
#
# Rule of thumb: everything about YOU stays out of git; the
# system that operates on it is tracked. Files ending in
# .example.* are the tracked templates for the ignored files.
# ============================================================

# --- Environment and secrets ---
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
*-credentials.json
service-account*.json

# --- Personal profile data (never commit) ---
data/master_cv.json
data/job_goals.json
data/application_profile.json
data/search_config.json
data/deep_experience.json
data/star_stories.json
data/technical_inventory.json
data/learning_gaps.md
data/linkedin_content.md
data/screening-answers*.md
data/*.docx
data/job_descriptions/

# --- Personal tracker and watchlist ---
data/tracker.json
data/tracker.csv
data/watchlist.json

# --- Runtime state and generated artefacts ---
data/.linkedin-state.json
data/.playwright-profile/
/applications/
data/applications/
data/auto-apply-runs/
data/apply-intelligence.json
data/last_email_check.json
data/seen_job_ids.json
data/company_watchlist_cache.json
/interview-prep/
/cover-letters/
/Second Brain/

# --- CV files with personal information ---
cv/sections/*.tex
!cv/sections/*.example.tex
cv/variants/
cv/profiles/
cv/master-cv.tex
cv/output/

# --- Claude Code local state (skills/agents ARE tracked) ---
.claude/settings.local.json
.claude/worktrees/
.claude/.DS_Store
.agents/
.codex/
AGENTS.md

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
venv/
ENV/
env/
.venv/

# --- IDE / OS ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/

# --- Logs ---
*.log
logs/

# --- Playwright ---
playwright-report/
test-results/

# --- LaTeX build artifacts ---
*.aux
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
