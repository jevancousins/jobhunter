# JobHunter environment variables
# Copy to .env and fill in. Created for you by /onboard.

# --- Notion (required) ---
# Integration token from notion.so/my-integrations; share your JobHunter page with it.
NOTION_API_KEY=secret_xxxxx
# The Jobs Database ID (from the database URL).
NOTION_JOBS_DB_ID=xxxxx
# Optional: a companies watchlist database.
NOTION_COMPANIES_DB_ID=

# --- Notifications (optional) ---
# Gmail app password for end-of-run email notifications (run_notify.py).
# The address itself lives in data/search_config.json notifications.email.
GMAIL_APP_PASSWORD=

# --- Anthropic API (NOT required) ---
# The pipeline bills LLM work against your Claude Code subscription.
# Only set this if you build your own API-billed extensions.
# ANTHROPIC_API_KEY=
